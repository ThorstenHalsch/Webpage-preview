---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/paths';
const people = [
  { role: '1. Vorstand', name: 'Hans Joachim Weis', email: 'vorstand1@verein-zufriedenheit.com' },
  { role: '2. Vorstand', name: 'Andreas Schneegans', email: 'vorstand2@verein-zufriedenheit.com' },
  { role: 'Schriftführer', name: 'Simon Hahn', email: 'schriftfuehrer@verein-zufriedenheit.com' },
  { role: 'Kassierer', name: 'Gunnar Hilken', email: 'kassier@verein-zufriedenheit.com' },
];
---
<BaseLayout title="Kontakt & Mitmachen">
  <section class="container page-intro"><a class="back-link" href={href()}>← Zur Startseite</a><span class="eyebrow">Kontakt & Mitmachen</span><h1>Der erste Schritt?<br />Einfach Hallo sagen.</h1><p>Du hast Fragen zum Verein, zu einer Veranstaltung oder zum Wasserrad? Unsere Ansprechpartner freuen sich auf deine Nachricht.</p></section>
  <section class="container" aria-label="Unsere Ansprechpartner"><div class="contact-grid">{people.map(person => <article class="contact-person"><span class="eyebrow">{person.role}</span><h2>{person.name}</h2><a class="text-link" href={`mailto:${person.email}`}><Icon name="mail" size={18} /> E-Mail schreiben <Icon name="diagonal" size={17} /></a></article>)}</div></section>
  <section class="container" id="mitmachen"><div class="contact-callout"><span class="eyebrow">Dabei sein</span><h2>Wir freuen uns auf neue Gesichter.</h2><p>Du möchtest unseren Verein kennenlernen, beim Wasserrad mithelfen oder mehr über eine Mitgliedschaft erfahren? Schreib unserem Vorstand. Gemeinsam finden wir einen guten Einstieg.</p><a class="button button-dark" href="mailto:vorstand1@verein-zufriedenheit.com?subject=Den%20VZO%20kennenlernen">Kontakt zum Vorstand <Icon name="arrow" /></a></div></section>
  <section class="section section-tinted"><div class="container"><span class="eyebrow">Unser Treffpunkt</span><h2>In Oberndorf zuhause.</h2><div class="info-grid"><article class="info-card"><h3>Fischküche Reck</h3><p>Unser Vereinslokal<br />Oberndorf 7<br />91096 Möhrendorf</p><a class="text-link" href="https://fischkueche-reck.de/">Zum Gasthaus <Icon name="diagonal" /></a></article><article class="info-card"><h3>Am Wasserrad</h3><p>Bei schönem Wetter trifft sich unser Wasserradstammtisch auch am Kleinen Schäferrad. Den genauen Treffpunkt kannst du beim Vorstand erfragen.</p><a class="text-link" href={href('wasserrad/')}>Unser Wasserrad <Icon name="diagonal" /></a></article></div></div></section>
</BaseLayout>
