---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import wheel from '../assets/wasserrad.webp';
import setup from '../assets/wasserrad-aufbau.webp';
import { href } from '../lib/paths';
---
<BaseLayout title="Das Kleine Schäferrad" description="Ein Stück Oberndorf in Bewegung: Der Verein Zufriedenheit betreut das Kleine Schäferrad an der Regnitz seit 1985 ehrenamtlich.">
  <section class="container page-intro"><a class="back-link" href={href()}>← Zur Startseite</a><span class="eyebrow">Das Kleine Schäferrad</span><h1>Ein Stück Heimat.<br />Immer in Bewegung.</h1><p>Holz, Wasser und viele helfende Hände. Unser Wasserrad erzählt von der Regnitz – und von Menschen, die sich für ihre Heimat einsetzen.</p></section>
  <section class="container story-grid"><div class="story-picture"><Image src={wheel} alt="Das Kleine Schäferrad schöpft Wasser aus der Regnitz" widths={[400, 600, 808]} sizes="(max-width: 899px) 100vw, 50vw" loading="eager" /></div><div class="story-copy"><h2>Alte Technik.<br />Lebendige Tradition.</h2><p>Seit über 600 Jahren wurden Wasserschöpfräder zur Bewässerung der landwirtschaftlichen Flächen im Regnitzbecken genutzt. Heute sind sie besondere Technik- und Kulturdenkmale.</p><p>Unser Verein betreut das Kleine Schäferrad seit 1985 ehrenamtlich. Der Wasserradstammtisch übernimmt den jährlichen Auf- und Abbau und kümmert sich um den Erhalt des Rades.</p><a class="text-link" href={href('kontakt/#mitmachen')}>Mithelfen & kennenlernen <Icon name="diagonal" /></a></div></section>
  <section class="section section-tinted"><div class="container"><span class="eyebrow">Ein Jahr am Wasserrad</span><h2>Tradition braucht viele Hände.</h2><div class="info-grid"><article class="info-card"><span class="eyebrow">Frühjahr</span><h3>Zusammen aufbauen.</h3><p>Um Walburgis, Ende April oder Anfang Mai, wird das über den Winter eingelagerte Rad aus rund 600 Einzelteilen zusammengebaut.</p></article><article class="info-card"><span class="eyebrow">Sommer</span><h3>In Bewegung bleiben.</h3><p>Die Strömung treibt das Rad an. Seine Kümpfe schöpfen Wasser, das über Trog und Rinne abgeleitet wird.</p></article><article class="info-card"><span class="eyebrow">Herbst & Winter</span><h3>Für morgen erhalten.</h3><p>Um Michaelis, Ende September, wird das Rad abgebaut und eingelagert. Verschlissene Teile werden ersetzt.</p></article></div></div></section>
  <section class="section container story-grid"><div class="story-copy"><span class="eyebrow">Handwerk & Gemeinschaft</span><h2>Aus Einzelteilen<br />wird Zusammenhalt.</h2><p>Eine Eichenholzwelle, zwei Radkränze, Speichen, Kümpfe und Schaufelbretter: Jedes Teil hat seinen Platz. Beim Aufbau greifen viele Hände und viel Erfahrung ineinander.</p><p>Unsere ehrenamtliche Arbeit hilft, das Wasserrad zu erhalten. Zugleich ist sie eine Gelegenheit, zusammen etwas Sichtbares zu schaffen.</p><a class="text-link" href="https://www.regnitzraeder.de/">Mehr über die Regnitzräder <Icon name="diagonal" /></a></div><div class="story-picture"><Image src={setup} alt="Das fertig aufgebaute Kleine Schäferrad mit Welle und Kümpfen" widths={[400, 600, 808]} sizes="(max-width: 899px) 100vw, 50vw" /></div></section>
</BaseLayout>
